default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    # API-key auth from env (set in fastlane/.env — gitignored)
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_KEY_PATH"],
      duration: 1200,
      in_house: false
    )

    # Auto-bump build number to the next available on TestFlight
    current = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.dailycatch.app"
    )
    increment_build_number(
      build_number: current + 1,
      xcodeproj: "TheDailyCatch.xcodeproj"
    )

    # Archive with automatic signing
    build_app(
      project: "TheDailyCatch.xcodeproj",
      scheme: "TheDailyCatch",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build/fastlane",
      export_options: {
        method: "app-store-connect",
        teamID: "YSMQYKV45W",
        signingStyle: "automatic",
        uploadBitcode: false,
        uploadSymbols: true
      }
    )

    # Upload to TestFlight (skip waiting for Apple processing; no beta review)
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
