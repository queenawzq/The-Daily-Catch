default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    # API-key auth from env (set in fastlane/.env — gitignored)
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_KEY_PATH"],
      duration: 1200,
      in_house: false
    )

    # Auto-bump build number: take max of TestFlight and local Info.plist, then +1.
    # Guards against latest_testflight_build_number returning 0/low values when the
    # API can't see prior builds, which would otherwise regress CFBundleVersion.
    testflight_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.dailycatch.app",
      initial_build_number: 0
    ).to_i
    local_build = get_info_plist_value(
      path: "TheDailyCatch/Info.plist",
      key: "CFBundleVersion"
    ).to_i
    next_build = [testflight_build, local_build].max + 1
    UI.message("TestFlight build: #{testflight_build}, local build: #{local_build}, next: #{next_build}")
    increment_build_number(
      build_number: next_build,
      xcodeproj: "TheDailyCatch.xcodeproj"
    )

    # Archive with automatic signing
    build_app(
      project: "TheDailyCatch.xcodeproj",
      scheme: "TheDailyCatch",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build/fastlane",
      export_options: {
        method: "app-store-connect",
        teamID: "YSMQYKV45W",
        signingStyle: "automatic",
        uploadBitcode: false,
        uploadSymbols: true
      }
    )

    # Upload to TestFlight (skip waiting for Apple processing; no beta review)
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
